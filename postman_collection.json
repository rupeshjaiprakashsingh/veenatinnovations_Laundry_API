{
  "info": {
    "name": "Laundry Management System API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login (Admin/Staff/Customer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@laundry.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.customer@email.com\",\n  \"mobileNumber\": \"9123456789\",\n  \"password\": \"password123\",\n  \"address\": \"789 Clean Blvd\",\n  \"city\": \"Clean City\",\n  \"state\": \"Sanitation State\",\n  \"pincode\": \"400002\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Create Employee (Admin/Manager only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Delivery Specialist\",\n  \"email\": \"delivery2@laundry.com\",\n  \"mobileNumber\": \"9555444333\",\n  \"role\": \"DeliveryBoy\",\n  \"branchId\": 1,\n  \"password\": \"delivery123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register-employee",
              "host": ["{{base_url}}"],
              "path": ["auth", "register-employee"]
            }
          }
        }
      ]
    },
