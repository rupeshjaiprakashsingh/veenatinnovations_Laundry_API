            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"branchId\": 1,\n  \"notes\": \"Standard laundry\",\n  \"discountAmount\": 2.0,\n  \"orderItems\": [\n    {\n      \"serviceId\": 1,\n      \"clothType\": \"Shirt\",\n      \"quantity\": 3\n    },\n    {\n      \"serviceId\": 3,\n      \"clothType\": \"Jeans\",\n      \"quantity\": 2\n    }\n  ]\n}"
